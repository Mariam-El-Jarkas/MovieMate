# Copy this file to .env and fill it in. Never share your .env file.
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Local PostgreSQL. For hosted PostgreSQL, use the provider's connection string.
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/moviemate
# Set true for hosted PostgreSQL requiring TLS; server certificates are verified.
DB_SSL=false

# Use a unique random value of at least 32 characters in production.
JWT_SECRET=change-me-to-a-long-random-text

# Movies: free key from themoviedb.org (Settings > API). Either the v3 key or the v4 read token works.
TMDB_API_KEY=

# Optional: only needed for outbound email notifications; authentication does not use email.
RESEND_API_KEY=
MAIL_FROM=
